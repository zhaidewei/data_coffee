{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-coffee-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": { "directory": "./web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "data-coffee-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "APP_ENV": "development", "MAIL_DAILY_LIMIT": "280" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
