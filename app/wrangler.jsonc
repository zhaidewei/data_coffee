{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-coffee",
  "account_id": "f1dc30bb93206c310ab2b840baceb857",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "coffee.nl-dams.com", "custom_domain": true }],
  "assets": { "directory": "./web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "data-coffee", "database_id": "12b21692-44ff-4b9f-9aad-a1ef57d7d3a0", "migrations_dir": "migrations" }],
  "vars": { "APP_ENV": "production", "APP_URL": "https://coffee.nl-dams.com", "APP_VERSION": "local", "EMAIL_FROM": "dewei.zhai@gmail.com", "EMAIL_FROM_NAME": "Data Coffee", "MAIL_DAILY_LIMIT": "280" },
  "triggers": { "crons": ["* * * * *", "17 * * * *"] },
  "observability": { "enabled": true }
}
