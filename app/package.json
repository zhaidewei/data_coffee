{
  "name": "data-coffee-web",
  "private": true,
  "type": "module",
  "bin": {
    "dc-flow": "cli/dc-flow.mjs"
  },
  "scripts": {
    "cli": "node cli/dc-flow.mjs",
    "dev": "wrangler dev --port 8787 --var APP_ENV:development --var APP_URL:http://localhost:8787",
    "check:migrations": "node scripts/check-migration-history.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "simulate:local": "node scripts/simulate-local-lifecycle.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:readback": "node scripts/release-readback.mjs",
    "release:deploy": "node scripts/release-deploy.mjs",
    "deploy:dev": "npm run release:deploy",
    "test:css": "node scripts/css-smoke.cjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@types/node": "22.20.1",
    "miniflare": "5.20260903.0-alpha",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.129.0"
  }
}
